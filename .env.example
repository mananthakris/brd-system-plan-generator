OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=org-...

# Models
ORCHESTRATOR_MODEL=gpt-4o
AGENT_MODEL=gpt-4o
FAST_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# RAG
CHROMA_PERSIST_DIR=.chroma
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.75

# Critic
CRITIC_PASS_THRESHOLD=0.70
MAX_REVISION_CYCLES=2

# State
SQLITE_DB_PATH=.state/checkpoints.db

# Company context
COMPANY_NAME=Verdant Intelligence
COMPANY_DOMAIN=energy_benchmarking_compliance
