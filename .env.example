OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=org-...

# Models
# Main reasoning model — used by the orchestrator and all real agents
ORCHESTRATOR_MODEL=gpt-5.4
AGENT_MODEL=gpt-5.4
# Fast/cheap model — used by the LLM-as-Judge eval harness (run_phoenix_evals.py)
FAST_MODEL=gpt-5.4-mini
# Embedding model — used by ChromaDB for RAG retrieval (independent of chat models above)
EMBEDDING_MODEL=text-embedding-3-small

# RAG
CHROMA_PERSIST_DIR=.chroma
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.75

# Critic
CRITIC_PASS_THRESHOLD=0.70
MAX_REVISION_CYCLES=2

# State
SQLITE_DB_PATH=.state/checkpoints.db

# Company context
COMPANY_NAME=Arbor Risk
COMPANY_DOMAIN=fraud_detection_risk_decisioning
